{
	"name": "hops-frontend",
	"private": true,
	"version": "3.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run icons:bundle && vite build",
		"icons:bundle": "node scripts/generate-icon-bundle.mjs",
		"icons:check": "node scripts/generate-icon-bundle.mjs --check",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.86",
		"@iconify/svelte": "5.1.0",
		"@iconify/utils": "^3.1.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/qrcode": "^1.5.6",
		"@vitest/ui": "^4.1.4",
		"jsdom": "^29.0.2",
		"sharp": "^0.35.5",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"qrcode": "^1.5.4"
	},
	"engines": {
		"node": ">=24"
	}
}

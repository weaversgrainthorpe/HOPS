# HOPS Configuration
# Copy this file to .env and adjust as needed.
# These can also be passed as command-line flags (see --help).

# Port the server listens on (default: 8080)
HOPS_PORT=8080

# Data directory for SQLite database, uploads, and backups (default: ../data)
HOPS_DATA_DIR=./data

# Path to the frontend build directory (default: ../frontend/build)
HOPS_FRONTEND_DIR=./frontend/build
